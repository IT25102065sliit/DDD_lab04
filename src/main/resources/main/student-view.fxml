<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="main.StudentController"
          hgap="10" vgap="12" alignment="CENTER">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Student ID (SID):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="txtSid" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="txtSname" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Address:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="txtAddress" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Date of Birth:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <DatePicker fx:id="dpDob" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="NIC:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextField fx:id="txtNic" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Label text="Course ID (CID):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <TextField fx:id="txtCid" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="1">
        <Button text="Add" onAction="#handleAdd"/>
        <Button text="Update" onAction="#handleUpdate"/>
        <Button text="Delete" onAction="#handleDelete"/>
    </HBox>

    <Label fx:id="lblStatus" GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
</GridPane>